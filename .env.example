# =========================================================================
# Root Monorepo Environment Configuration (.env.example)
# TaskHub Monorepo (Frontend + Backend)
# =========================================================================

# -------------------------------------------------------------------------
# 1. GITHUB ACTIONS SECRETS (Di-sync via sync.js / GitHub Repo Secrets)
# -------------------------------------------------------------------------
GHCR_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
SSH_KEY="-----BEGIN OPENSSH PRIVATE KEY-----\n...\n-----END OPENSSH PRIVATE KEY-----"
VPS_HOST=123.45.67.89

# -------------------------------------------------------------------------
# 2. GITHUB ACTIONS VARIABLES (Di-sync via sync.js / GitHub Repo Variables)
# Dipakai saat docker build_args di GitHub Actions:
# -------------------------------------------------------------------------
ENVIRONMENT=production
VITE_API_URL=https://api.yourdomain.com
VITE_APP_API_URL=https://api.yourdomain.com
VITE_WS_URL=wss://api.yourdomain.com/api/v1/ws
VITE_ENABLE_MOCKS=false
VITE_GOOGLE_CLIENT_ID=1234567890-abcdefg123456.apps.googleusercontent.com
VITE_APPLE_CLIENT_ID=com.taskhub.web.auth

# -------------------------------------------------------------------------
# 3. BACKEND CONFIGURATION
# -------------------------------------------------------------------------
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=task-management
DB_SSLMODE=disable

REDIS_HOST=localhost
REDIS_PORT=6379

JWT_ACCESS_SECRET=change-this-to-a-random-secret-key-min-32-characters
JWT_REFRESH_SECRET=change-this-to-another-random-secret-key-min-32-chars

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=postmessage

APPLE_CLIENT_ID=com.taskhub.web.auth
APPLE_BUNDLE_ID=com.taskhub.app
APPLE_TEAM_ID=XXXXXXXXXX
APPLE_KEY_ID=YYYYYYYYYY
