# =========================================================================
# Backend Environment Configuration (backend/.env)
# =========================================================================

# === Application ===
APP_NAME=task-hub-backend
ENVIRONMENT=development   # development | production

# === Server ===
SERVER_HOST=0.0.0.0
SERVER_PORT=3000

# === Logging ===
# Semua log selalu JSON (satu record per baris), siap untuk log aggregation.
LOG_LEVEL=info            # debug | info | warn | error
#LOG_FILE=logs/app.log

# === Feature Flags ===
# Turn optional integrations on/off. When disabled, the dependency is never
# initialized and the app runs without it. Status is reported in /health and
# at startup.
REDIS_ENABLED=true
RABBITMQ_ENABLED=true

# --- Realtime (WebSocket + SSE) ---
# Master switch. When off, both realtime_sse and realtime_ws are forced off.
REALTIME_ENABLED=true
# SSE and WS are independently togglable.
REALTIME_SSE_ENABLED=true      # Server-Sent Events
REALTIME_WS_ENABLED=true       # WebSocket
# Distributed fan-out transport across instances (auto-scaled fleets):
#   redis    -> Redis pub/sub (default, always compatible with the hub)
#   rabbitmq -> RabbitMQ fanout exchange (requires RABBITMQ_ENABLED=true)
#   both     -> publish on Redis AND RabbitMQ
# If the backing service for the chosen transport is disabled/missing, the
# hub degrades to single-instance (local) mode instead of failing to boot.
REALTIME_BRIDGE=redis

# === Database ===
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=task-management
DB_SSLMODE=disable

# === Redis ===
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_USERNAME=
REDIS_PASSWORD=
REDIS_DB=0

# === RabbitMQ ===
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_VHOST=/

# === JWT ===
# IMPORTANT: Change these secrets in production!
# Use at least 32 characters for better security
JWT_ACCESS_SECRET=change-this-to-a-random-secret-key-min-32-characters
JWT_REFRESH_SECRET=change-this-to-another-random-secret-key-min-32-chars
JWT_ACCESS_DURATION=15      # Access token duration in minutes
JWT_REFRESH_DURATION=168    # Refresh token duration in hours (7 days)
JWT_ISSUER=task-hub

# === OpenTelemetry ===
OTEL_ENABLED=false
OTEL_SERVICE_NAME=task-hub-backend
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_EXPORTER_OTLP_PROTOCOL=grpc
OTEL_TRACES_SAMPLER=parentbased_traceidratio
OTEL_TRACES_SAMPLER_ARG=0.2

# === OAuth Providers (Google & Apple) ===
# Create in Google Cloud Console > APIs & Services > Credentials > OAuth 2.0 Client IDs (Web Application)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=postmessage

# Apple Developer Account > Certificates, Identifiers & Profiles
# APPLE_CLIENT_ID: Services ID for Web (e.g. cloud.eka-dev.task-hub.service) - supports comma-separated values
# APPLE_BUNDLE_ID: App Bundle ID for iOS / Mobile (e.g. cloud.eka-dev.task-hub)
# Server-to-server webhook endpoint: POST /api/v1/auth/apple/webhook
APPLE_CLIENT_ID=
APPLE_BUNDLE_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=

# === CORS (Cross-Origin Resource Sharing) ===
# Comma-separated origins (without trailing slashes or wildcard * because AllowCredentials=true)
# Default if empty: http://localhost:3000,http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,https://task-hub.eka-dev.cloud

# === Reminders, Asynq & Notifications ===
REMINDER_ENABLED=true
# Base URL accessed by external worker-asynq for HTTP callbacks (falls back to WEBHOOK_BASE_URL)
APP_URL=http://localhost:3000
WEBHOOK_BASE_URL=http://localhost:3000
# Internal shared secret verified on webhook triggers via X-Internal-Token or X-Webhook-Secret
INTERNAL_TOKEN=task-management-reminder-secret
REMINDER_WEBHOOK_SECRET=task-management-reminder-secret
RESEND_API_KEY=
RESEND_FROM_EMAIL=onboarding@resend.dev
FCM_PROJECT_ID=
FCM_CREDENTIALS_BASE64=
FCM_SERVICE_ACCOUNT_KEY=
FCM_CREDENTIALS_FILE=