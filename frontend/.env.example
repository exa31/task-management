# =========================================================================
# Frontend Environment Configuration (frontend/.env)
# =========================================================================

# API Base URL & WebSocket (Kosongkan jika menggunakan reverse-proxy same-domain /api)
# Nilai ini dapat diset melalui GitHub Actions Repository Variables (VARS_TO_SYNC)
VITE_API_URL=
VITE_APP_API_URL=
VITE_WS_URL=

# Offline fallback mock data flag ('true' untuk menggunakan data demo lokal jika API backend tidak terhubung)
VITE_ENABLE_MOCKS=false

# Google OAuth 2.0 Web Client ID
# Contoh: 1234567890-abcdefg123456.apps.googleusercontent.com
VITE_GOOGLE_CLIENT_ID=

# Apple Services ID
# Contoh: com.taskhub.web.auth
VITE_APPLE_CLIENT_ID=

# Firebase Cloud Messaging (Web Push Notifications)
# Dapatkan dari Firebase Console > Project Settings > General > Your apps (Web App)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
# Dapatkan dari Firebase Console > Project Settings > Cloud Messaging > Web configuration > Web Push certificates (Key pair)
VITE_FIREBASE_VAPID_KEY=
