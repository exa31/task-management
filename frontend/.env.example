# =========================================================================
# Frontend Environment Configuration (frontend/.env)
# =========================================================================

# API Base URL & WebSocket (Kosongkan jika menggunakan reverse-proxy same-domain /api)
# Nilai ini dapat diset melalui GitHub Actions Repository Variables (VARS_TO_SYNC)
VITE_API_URL=
VITE_APP_API_URL=
VITE_WS_URL=

# Offline fallback mock data flag ('true' untuk menggunakan data demo lokal jika API backend tidak terhubung)
VITE_ENABLE_MOCKS=false

# Google OAuth 2.0 Web Client ID
# Contoh: 1234567890-abcdefg123456.apps.googleusercontent.com
VITE_GOOGLE_CLIENT_ID=

# Apple Services ID
# Contoh: com.taskhub.web.auth
VITE_APPLE_CLIENT_ID=
