# =========================================================================
# Task Hub iOS - Environment Configuration (.env)
# =========================================================================
# PERHATIAN KEAMANAN:
# File ini HANYA untuk konfigurasi publik / client-side identifier.
# JANGAN pernah meletakkan private keys, p12 password, atau token rahasia di sini!
# Secret Apple Developer & TestFlight dikelola di GitHub Actions Secrets.
# =========================================================================

# Environment Mode: development | staging | production
ENVIRONMENT=production

# Base URL backend REST API
API_BASE_URL=https://be-task-hub.eka-dev.cloud/api/v1

# OAuth Client Identifiers (Public Client IDs)
GOOGLE_CLIENT_ID=897905079551-86q6g4ov6b966r2t7sbmqsmks5bea682.apps.googleusercontent.com
